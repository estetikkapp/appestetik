# ============================================
# Variables de entorno — appestetika
# Copiar a .env.local y completar valores
# ============================================

# Supabase (obligatorio Sprint 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Postergados a sprints siguientes
# ============================================

# AFIP — credenciales son PER-ORG, no globales.
# Cada centro carga sus propias credenciales TusFacturas en /configuracion → AFIP.
# Se guardan en organizations.afip_config (jsonb). NO setear como env vars.

# Mercado Pago — cuenta del SAAS (appestetika) para cobrar suscripciones
# a las clínicas. Distinto de las creds per-org que cada clínica carga en
# su /configuracion para cobrar a SUS clientas (esas viven en
# organizations.mp_config, no acá).
#
# Sacar de mercadopago.com.ar → Tu app de appestetika → Credentials.
# MP_APPESTETIKA_ACCESS_TOKEN=APP_USR-xxx
# MP_APPESTETIKA_WEBHOOK_SECRET=firma-secreta-de-webhooks
#
# Mercado Pago — LEGACY per-org (Sprint anterior, ya no se usan como env
# vars globales — cada clínica las carga en su /configuracion)
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=

# WhatsApp — Evolution API (Sprint 3)
# Levantar una instancia de Evolution API en un VPS (ver docs/superpowers/plans/)
# EVOLUTION_API_URL=https://evo.tudominio.com
# EVOLUTION_API_KEY=tu-api-key-global

# Cron secret — protege los endpoints /api/cron/*
# CRON_SECRET=genera-un-string-aleatorio-largo

# Supabase Management API token (sbp_...) — solo necesario para `npm run health`
# Se obtiene en https://supabase.com/dashboard/account/tokens. NO se sube a Vercel,
# es solo para que tu máquina pueda chequear el schema de prod.
# SUPABASE_MANAGEMENT_TOKEN=sbp_...

# Meta Pixel ID — para tracking de conversiones desde Meta Ads (sin esto el
# pixel no se carga, lo cual es lo correcto en local/preview).
# Se saca de business.facebook.com → Events Manager → Pixel ID.
# NEXT_PUBLIC_META_PIXEL_ID=1266594805635000

# Notificaciones internas al equipo cuando hay nuevos signups, trials, etc.
# CSV de emails. Default si no se setea: estetikkapp@gmail.com.
# Requiere RESEND_API_KEY configurado (si no, las notificaciones quedan en
# log warning, no rompen el signup).
# ADMIN_NOTIFICATION_EMAILS=estetikkapp@gmail.com,tomicomerce@gmail.com

# Claude (Sprint 5)
# ANTHROPIC_API_KEY=
